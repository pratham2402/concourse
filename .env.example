QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Nebius Token Factory. The key is server-side only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_ENABLED=false
# Use a model whose Nebius catalog page says "Public endpoint: Available".
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
LLM_DISABLE_AFTER=2026-11-06T00:00:00Z
LLM_TOTAL_CALL_LIMIT=200
LLM_DAILY_CALL_LIMIT=50
LLM_PER_IP_HOURLY_LIMIT=6
LLM_MAX_TOKENS=450
LLM_TIMEOUT_MS=20000
