QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Nebius Token Factory. The key is server-side only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_ENABLED=false
# A public text-to-text model available on the account.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_DISABLE_AFTER=2026-11-06T00:00:00Z
LLM_TOTAL_CALL_LIMIT=200
LLM_DAILY_CALL_LIMIT=50
LLM_PER_IP_HOURLY_LIMIT=6
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_MS=20000
